<Project>
  <PropertyGroup>
    <!-- The one version: assembly versions, the About section and the package version all read it. Pre-1.0 until the 1.0 release. -->
    <Version>0.9.11</Version>
    <!-- Temporary: the Windows setup installs into %LOCALAPPDATA%\<pack id> and clears it on install, and builds packed as SavePointApp keep their data in %LOCALAPPDATA%\SavePoint, so the id stays SavePointApp until every install has moved its data out. Then it goes and SavepointPackId serves both platforms. -->
    <SavepointWindowsPackId>SavePointApp</SavepointWindowsPackId>
    <!-- Everywhere else the app is "SavePoint": the AppImage's name, its desktop entry, and the window class the shell shows. -->
    <SavepointPackId>SavePoint</SavepointPackId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only runs in the build when documentation output is on. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
