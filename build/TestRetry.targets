<Project>

  <!--
    Loads Microsoft.Testing.Extensions.Retry into the test projects, so a test run can be told to retry failed tests.
    Only the Linux gate (build/gate-linux.sh) sets SAVEPOINT_TEST_RETRIES, because its workspace sits on a 9p mount where
    a file just renamed into place can be briefly invisible (D27). Every other build leaves the extension out, so the
    Windows gate has no way to retry a test and a real race in SavePoint's own code still fails it.
  -->
  <ItemGroup Condition="'$(SAVEPOINT_TEST_RETRIES)' != ''">
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" />
  </ItemGroup>

</Project>
