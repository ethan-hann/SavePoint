<Project>

  <!--
    Loads Microsoft.Testing.Extensions.Retry into the test projects, so a test run can be told to retry failed tests.
    SAVEPOINT_TEST_RETRIES was set by the former WSL gate, whose workspace sat on a 9p mount where a file just renamed into
    place could be briefly invisible (D27). No script sets it now, so no build loads the extension and a real race in
    SavePoint's own code still fails the gate.
  -->
  <ItemGroup Condition="'$(SAVEPOINT_TEST_RETRIES)' != ''">
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" />
  </ItemGroup>

</Project>
