<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:samples="using:Savepoint.App.Tests.Features.Common.Samples"
             x:Class="Savepoint.App.Tests.Features.Common.Samples.SaveStatusView"
             x:DataType="samples:SaveStatusViewModel">
  <ItemsControl ItemsSource="{Binding Rows}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="samples:SaveStatusRow">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="icon s18" Classes.accent="{Binding Succeeded}" Classes.error="{Binding !Succeeded}" Text="{Binding Icon}" />
          <TextBlock Classes="body" VerticalAlignment="Center" Text="{Binding Text}" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
