<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Savepoint.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <!-- The regular Linux libSkiaSharp.so needs libfontconfig, which WSL and minimal Linux images lack, and without Skia no
         headless test can start. The app's fonts are embedded, so the tests use the build that needs no fontconfig. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Savepoint.App\Savepoint.App.csproj" />

    <!-- The stand-in game is only started as a child process; referencing it builds it first without linking it. -->
    <ProjectReference Include="..\..\tools\FakeGame\FakeGame.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeGameDirectory</_Parameter1>
      <!-- Forward slashes: this text goes into the assembly verbatim and must resolve on Linux too. -->
      <_Parameter2>$(MSBuildThisFileDirectory)../../tools/FakeGame/bin/$(Configuration)/$(TargetFramework)/</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestEnvironment.cs" Link="Shared\TestEnvironment.cs" />
    <Compile Include="..\Shared\TestImages.cs" Link="Shared\TestImages.cs" />
    <Compile Include="..\Shared\RecordingDiagnosticLog.cs" Link="Shared\RecordingDiagnosticLog.cs" />
    <Compile Include="..\..\tools\IconGen\IconColors.cs" Link="Shared\IconColors.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Theme\Material\golden-mcu-0.3.0.json" LogicalName="golden-mcu-0.3.0.json" />
  </ItemGroup>

  <Import Project="..\..\build\Git.targets" />
  <Import Project="..\..\build\TestRetry.targets" />

</Project>
