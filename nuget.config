<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keeps restores inside the workspace; resolved relative to this file. -->
    <add key="globalPackagesFolder" value=".tools/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
