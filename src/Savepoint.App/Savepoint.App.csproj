<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SavePoint</AssemblyName>
    <RootNamespace>Savepoint.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MessageFormat" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Savepoint.Core\Savepoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LogicalName keeps names path-shaped (Lang/en/app.json) so a folder such as en-GB is not mangled into an identifier. -->
    <EmbeddedResource Include="Localization\Assets\Lang\**\*.json" LogicalName="Lang/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**" />
  </ItemGroup>

  <Import Project="..\..\build\Git.targets" />

</Project>
