<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:common="using:Savepoint.App.Features.Common"
             xmlns:art="using:Savepoint.App.Features.Common.Art"
             xmlns:history="using:Savepoint.App.Features.History"
             xmlns:help="using:Savepoint.App.Features.Help"
             xmlns:a11y="using:Savepoint.App.Features.Common.Accessibility"
             xmlns:search="using:Savepoint.App.Features.Common.Search"
             x:Class="Savepoint.App.Features.History.HistoryScreenView"
             x:DataType="history:HistoryScreenViewModel">
  <!-- The History screen: the list view and the cards view. -->
  <UserControl.Styles>
    <!-- Timeline: an 11px dot per entry on a 2px rail; the point in use has a filled dot. -->
    <Style Selector="Border.timeline-dot">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineVariantBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.timeline-dot.filled">
      <Setter Property="BorderBrush" Value="{DynamicResource Md3PrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
    </Style>
    <Style Selector="Border.timeline-rail">
      <Setter Property="Width" Value="2" />
      <Setter Property="Background" Value="{DynamicResource Md3OutlineVariantBrush}" />
    </Style>

    <!-- A save in the list: a bordered row; the loaded one is tinted and outlined in primary. -->
    <Style Selector="Border.save-row">
      <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Md3BorderThin}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusRow}" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.save-row.loaded">
      <Setter Property="BorderBrush" Value="{DynamicResource Md3PrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource Md3SelectedRowBrush}" />
    </Style>

    <!-- The loaded card is tinted like the loaded row, besides its primary outline. -->
    <Style Selector="Border.card.selected">
      <Setter Property="Background" Value="{DynamicResource Md3SelectedRowBrush}" />
    </Style>

    <!-- The Recently removed header is a toggle that reads as a plain row: opening it must not fill it like a chosen chip. -->
    <Style Selector="ToggleButton.section-toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
    </Style>
    <Style Selector="ToggleButton.section-toggle:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
    </Style>

    <!-- The LOADED and LOADED NOW chips. -->
    <Style Selector="Border.status-chip">
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryContainerBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusPill}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status-chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryContainerBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.3" />
    </Style>
  </UserControl.Styles>

  <!-- The whole screen scrolls: the header, the explanation, the snapshots, the removed ones and the footer move together when the window is too short for them. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <DockPanel>

    <!-- Header: the game, the profile filter and the Cards / List toggle. -->
    <Border x:Name="Header"
            DockPanel.Dock="Top"
            Padding="22,15"
            BorderBrush="{DynamicResource Md3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding !HasNoGame}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <art:ArtTile Size="34" GameName="{Binding GameName}" Art="{Binding Art}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
          <!-- A wrap panel, so the question drops under the title when the window is too narrow for both on one line. -->
          <WrapPanel Orientation="Horizontal">
            <TextBlock x:Name="TitleText" Classes="section-title" VerticalAlignment="Center" Margin="0,0,12,0" Text="{loc:Loc history.title}" />
            <help:HelpQuestionView VerticalAlignment="Center" DataContext="{Binding SnapshotHelp}" />
          </WrapPanel>
          <TextBlock x:Name="SubtitleText" Classes="timestamp" FontSize="12" Text="{Binding Subtitle}" />
        </StackPanel>
        <Button x:Name="FilterButton"
                Grid.Column="2"
                Classes="pill"
                Margin="0,0,12,0"
                Padding="14,8"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Md3OnSurfaceBrush}"
                IsVisible="{Binding ShowFilter}"
                AutomationProperties.Name="{Binding FilterAutomationName}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opened="OnFilterOpened">
              <!-- Arrow keys only move through the list: the choice is made by a click or Enter, which closes it. -->
              <a11y:ChoiceListBox x:Name="FilterList"
                       Classes="rows"
                       MinWidth="220"
                       ItemsSource="{Binding Filters}"
                       SelectedItem="{Binding SelectedFilter, Mode=OneWay}"
                       AutomationProperties.Name="{loc:Loc history.filter.listName}"
                       PointerReleased="OnFilterPointerReleased">
                <a11y:ChoiceListBox.Styles>
                  <Style Selector="ListBoxItem" x:DataType="history:ProfileFilter">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                  </Style>
                </a11y:ChoiceListBox.Styles>
                <a11y:ChoiceListBox.ItemTemplate>
                  <DataTemplate x:DataType="history:ProfileFilter">
                    <TextBlock Classes="body" Text="{Binding Label}" />
                  </DataTemplate>
                </a11y:ChoiceListBox.ItemTemplate>
              </a11y:ChoiceListBox>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.FilterList}" />
            <TextBlock Text="{Binding FilterLabel}" />
          </StackPanel>
        </Button>
        <a11y:ChoiceListBox x:Name="ViewToggle"
                 Grid.Column="3"
                 Classes="segmented-tray"
                 VerticalAlignment="Center"
                 IsVisible="{Binding HasPoints}"
                 ItemsSource="{Binding ViewOptions}"
                 SelectedItem="{Binding SelectedViewOption, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding ViewLabel}">
          <a11y:ChoiceListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="history:ViewModeOption">
              <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
              <Setter Property="Padding" Value="14,7" />
            </Style>
          </a11y:ChoiceListBox.Styles>
          <a11y:ChoiceListBox.ItemTemplate>
            <DataTemplate x:DataType="history:ViewModeOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </a11y:ChoiceListBox.ItemTemplate>
        </a11y:ChoiceListBox>
      </Grid>
    </Border>

    <!-- The answer to "What's a snapshot?" opens here, under the header, over a full line. The margin sits on a wrapper that hides with the answer, so a closed answer takes no room. -->
    <Panel DockPanel.Dock="Top" Margin="22,12,22,0" IsVisible="{Binding SnapshotHelp.IsOpen}">
      <help:HelpAnswerView DataContext="{Binding SnapshotHelp}" />
    </Panel>

    <!-- Search: words found in a snapshot's name, profile, date or what it holds, and a choice of Saves or Game and mods. The profile filter above stays the way to pick a profile. -->
    <Border x:Name="SearchRow" DockPanel.Dock="Top" Padding="22,14,22,0" IsVisible="{Binding ShowSearch}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <search:SearchBoxView x:Name="HistorySearchBox" VerticalAlignment="Center" DataContext="{Binding Search}" />
        <a11y:ChoiceListBox x:Name="KindToggle"
                 Grid.Column="1"
                 Classes="segmented-tray"
                 VerticalAlignment="Center"
                 ItemsSource="{Binding KindOptions}"
                 SelectedItem="{Binding SelectedKindOption, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding KindLabel}">
          <a11y:ChoiceListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="history:KindOption">
              <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
              <Setter Property="Padding" Value="14,7" />
            </Style>
          </a11y:ChoiceListBox.Styles>
          <a11y:ChoiceListBox.ItemTemplate>
            <DataTemplate x:DataType="history:KindOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </a11y:ChoiceListBox.ItemTemplate>
        </a11y:ChoiceListBox>
      </Grid>
    </Border>

    <!-- Room for the job pill under the footer, so the footer is never under it. -->
    <Border x:Name="PillRoom" DockPanel.Dock="Bottom" Classes="pill-room" />

    <!-- Footer: how much space SavePoint keeps for the game. -->
    <Border x:Name="Footer"
            DockPanel.Dock="Bottom"
            Padding="22,14"
            BorderBrush="{DynamicResource Md3OutlineVariantBrush}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding HasFooter}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <TextBlock Classes="icon s18 muted" Text="{x:Static theme:Icons.Database}" />
        <TextBlock x:Name="FooterText" Grid.Column="1" Classes="caption" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding FooterText}" />
      </Grid>
    </Border>

    <!-- Recently removed: snapshots that left a profile, closed until opened and hidden when there are none. Docked above the footer, under the snapshots. -->
    <Border x:Name="RemovedSection"
            DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource Md3OutlineVariantBrush}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding ShowRemoved}">
      <StackPanel>
        <ToggleButton x:Name="RemovedToggle"
                      Classes="text section-toggle"
                      Padding="22,12"
                      IsChecked="{Binding IsRemovedOpen, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding RemovedHeading}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Classes="icon s20 accent" Text="{x:Static theme:Icons.History}" />
            <TextBlock x:Name="RemovedHeadingText" Grid.Column="1" Classes="row-title" FontSize="14" VerticalAlignment="Center" Text="{Binding RemovedHeading}" />
            <Panel Grid.Column="2">
              <TextBlock Classes="icon s20 muted" IsVisible="{Binding !IsRemovedOpen}" Text="{x:Static theme:Icons.ExpandMore}" />
              <TextBlock Classes="icon s20 muted" IsVisible="{Binding IsRemovedOpen}" Text="{x:Static theme:Icons.ExpandLess}" />
            </Panel>
          </Grid>
        </ToggleButton>
        <StackPanel x:Name="RemovedContent" Margin="22,0,22,18" Spacing="12" IsVisible="{Binding IsRemovedOpen}">
            <TextBlock x:Name="RemovedNoteText" Classes="caption" FontSize="12.5" TextWrapping="Wrap" IsVisible="{Binding !HasRemovedError}" Text="{Binding RemovedNote}" />
            <TextBlock x:Name="RemovedErrorText"
                       Classes="body error"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasRemovedError}"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding RemovedError}" />
            <TextBlock x:Name="RemovedNoMatchesLine" Classes="body" TextWrapping="Wrap" IsVisible="{Binding ShowRemovedNoMatches}" Text="{Binding RemovedNoMatchesText}" />
            <ItemsControl x:Name="RemovedList"
                          ItemsSource="{Binding Removed}"
                          AutomationProperties.ControlTypeOverride="List"
                          AutomationProperties.Name="{Binding RemovedHeading}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="history:RemovedSnapshotViewModel">
                  <Border Classes="save-row"
                          AutomationProperties.ControlTypeOverride="ListItem"
                          AutomationProperties.Name="{Binding ItemAutomationName}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock Classes="caption" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Detail}" />
                        <TextBlock Classes="caption" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Origin}" />
                        <TextBlock Classes="timestamp" Text="{Binding Removed}" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="pill"
                              Padding="16,7"
                              VerticalAlignment="Center"
                              Command="{Binding BringBackCommand}"
                              Content="{loc:Loc history.removed.bringBack}"
                              AutomationProperties.Name="{Binding BringBackAutomationName}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The snapshots take the rest of the screen but never less than three rows; below that the whole screen scrolls. -->
    <common:FloorHeightHost Floor="220">
    <Panel x:Name="BodyRegion">

      <!-- The points: the two-column list or the cards. -->
      <Panel x:Name="PointsRegion" IsVisible="{Binding ShowPoints}">

        <!-- The saves column is wider: its lines carry a date and a profile name, which the timeline's do not. -->
        <Grid x:Name="ListRegion" ColumnDefinitions="4*,Auto,5*" IsVisible="{Binding IsListView}">
          <ScrollViewer x:Name="VersionsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,20,22,22" Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="icon s20 accent" Text="{x:Static theme:Icons.Folder}" />
                <TextBlock x:Name="VersionsHeading"
                           Classes="muted"
                           FontSize="12.5"
                           FontWeight="Medium"
                           LetterSpacing="0.5"
                           VerticalAlignment="Center"
                           Text="{theme:Upper {loc:Loc history.column.versions}}" />
              </StackPanel>
              <ItemsControl x:Name="TimelineList"
                            ItemsSource="{Binding Timeline}"
                            AutomationProperties.ControlTypeOverride="List"
                            AutomationProperties.Name="{loc:Loc history.column.versions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="history:TimelineEntryViewModel">
                    <Grid ColumnDefinitions="11,14,*"
                          AutomationProperties.ControlTypeOverride="ListItem"
                          AutomationProperties.Name="{Binding AutomationName}">
                      <Grid RowDefinitions="Auto,*">
                        <Border Classes="timeline-dot" Classes.filled="{Binding IsInUse}" Margin="0,5,0,0" />
                        <Border Grid.Row="1" Classes="timeline-rail" HorizontalAlignment="Center" IsVisible="{Binding HasRail}" />
                      </Grid>
                      <StackPanel Grid.Column="2" Margin="0,0,0,20" Spacing="2">
                        <TextBlock Classes="row-title" FontSize="14" TextWrapping="Wrap" Text="{Binding Headline}" />
                        <TextBlock Classes="caption" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Detail}" />
                        <TextBlock Classes="timestamp" Text="{Binding Stamp}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding CanGoBack}">
                          <Button Classes="pill"
                                  Padding="14,5"
                                  Command="{Binding GoBackCommand}"
                                  Content="{loc:Loc history.card.goBack}"
                                  AutomationProperties.Name="{Binding GoBackAutomationName}" />
                          <Button Classes="text pill"
                                  Padding="14,5"
                                  Command="{Binding SwitchCommand}"
                                  Content="{loc:Loc history.card.switch}"
                                  AutomationProperties.Name="{Binding SwitchAutomationName}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1" Width="1" Background="{DynamicResource Md3OutlineVariantBrush}" />

          <ScrollViewer x:Name="SavesScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,20,22,22" Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="icon s20 accent" Text="{x:Static theme:Icons.Save}" />
                <TextBlock x:Name="SavesHeading"
                           Classes="muted"
                           FontSize="12.5"
                           FontWeight="Medium"
                           LetterSpacing="0.5"
                           VerticalAlignment="Center"
                           Text="{theme:Upper {loc:Loc history.column.saves}}" />
              </StackPanel>
              <ItemsControl x:Name="SavesList"
                            ItemsSource="{Binding Saves}"
                            AutomationProperties.ControlTypeOverride="List"
                            AutomationProperties.Name="{loc:Loc history.column.saves}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="history:SaveRowViewModel">
                    <Border Classes="save-row"
                            Classes.loaded="{Binding IsLoaded}"
                            AutomationProperties.ControlTypeOverride="ListItem"
                            AutomationProperties.Name="{Binding ItemAutomationName}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Classes="caption" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Detail}" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="status-chip" IsVisible="{Binding IsLoaded}">
                          <TextBlock Text="{theme:Upper {loc:Loc history.save.loaded}}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanLoad}">
                          <Button Classes="pill"
                                  Padding="16,7"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Command="{Binding LoadCommand}"
                                  Content="{loc:Loc history.save.load}"
                                  AutomationProperties.Name="{Binding LoadAutomationName}" />
                          <Button Classes="text pill"
                                  Padding="12,5"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Command="{Binding SwitchCommand}"
                                  Content="{loc:Loc history.card.switch}"
                                  AutomationProperties.Name="{Binding SwitchAutomationName}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <ScrollViewer x:Name="CardsRegion" IsVisible="{Binding IsCardsView}" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="GroupList" Margin="22,14,22,22" ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="history:PointGroupViewModel">
                <StackPanel>
                  <TextBlock Classes="overline" FontSize="12.5" Margin="0,6,0,7" Text="{Binding Heading, Converter={x:Static theme:UppercaseConverter.Instance}}" />
                  <ItemsControl Margin="-7,0"
                                ItemsSource="{Binding Cards}"
                                AutomationProperties.ControlTypeOverride="List"
                                AutomationProperties.Name="{Binding Heading}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <common:AdaptiveUniformGrid MinItemWidth="210" MaxColumns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="history:PointCardViewModel">
                        <Border Classes="card"
                                Classes.selected="{Binding IsLoaded}"
                                Margin="7"
                                AutomationProperties.ControlTypeOverride="ListItem"
                                AutomationProperties.Name="{Binding ItemAutomationName}">
                          <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="26">
                              <TextBlock Classes="icon s24 muted" Classes.accent="{Binding IsLoaded}" HorizontalAlignment="Left" Text="{Binding Icon}" />
                              <Border Grid.Column="1" Classes="status-chip" IsVisible="{Binding IsLoaded}">
                                <TextBlock Text="{theme:Upper {loc:Loc history.card.loadedNow}}" />
                              </Border>
                            </Grid>
                            <StackPanel Spacing="3">
                              <TextBlock Classes="card-heading" FontSize="15" TextWrapping="Wrap" Text="{Binding Name}" />
                              <TextBlock Classes="caption" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Contains}" />
                              <TextBlock Classes="timestamp" Margin="0,3,0,0" Text="{Binding Date}" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,5,0,0" IsVisible="{Binding CanGoBack}">
                              <Button Classes="pill"
                                      Padding="16,9"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      Command="{Binding GoBackCommand}"
                                      Content="{loc:Loc history.card.goBack}"
                                      AutomationProperties.Name="{Binding GoBackAutomationName}" />
                              <Button Classes="text pill"
                                      Padding="16,7"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      Command="{Binding SwitchCommand}"
                                      Content="{loc:Loc history.card.switch}"
                                      AutomationProperties.Name="{Binding SwitchAutomationName}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>

      <!-- A search and kind choice that leave no snapshot. -->
      <StackPanel x:Name="SearchEmptyState" IsVisible="{Binding IsSearchEmpty}" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="26">
        <TextBlock Classes="card-title" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding SearchNoMatchesText}" />
        <Button Classes="pill" Padding="18,8" HorizontalAlignment="Center" Command="{Binding Search.ClearCommand}" Content="{loc:Loc search.clear}" />
      </StackPanel>

      <StackPanel x:Name="LoadingState" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <ProgressBar IsIndeterminate="True" Width="160" AutomationProperties.Name="{loc:Loc history.loading}" />
        <TextBlock Classes="body muted" HorizontalAlignment="Center" Text="{loc:Loc history.loading}" />
      </StackPanel>

      <ContentControl x:Name="ErrorHost"
                      Content="{Binding ErrorCard}"
                      IsVisible="{Binding HasError}"
                      MaxWidth="560"
                      Margin="26"
                      VerticalAlignment="Center" />

      <StackPanel x:Name="EmptyState" IsVisible="{Binding IsEmpty}" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="26">
        <Border Width="56" Height="56" HorizontalAlignment="Center" CornerRadius="16" Background="{DynamicResource Md3SurfaceContainerBrush}">
          <TextBlock Classes="icon s28 accent" HorizontalAlignment="Center" Text="{x:Static theme:Icons.History}" />
        </Border>
        <TextBlock x:Name="EmptyTitle" Classes="card-title" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !IsFilteredEmpty}" Text="{loc:Loc history.empty.title}" />
        <TextBlock x:Name="EmptyBody" Classes="body muted" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !IsFilteredEmpty}" Text="{loc:Loc history.empty.body}" />
        <TextBlock x:Name="FilteredEmptyTitle" Classes="card-title" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsFilteredEmpty}" Text="{loc:Loc history.empty.filteredTitle}" />
        <TextBlock x:Name="FilteredEmptyBody" Classes="body muted" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsFilteredEmpty}" Text="{loc:Loc history.empty.filteredBody}" />
        <Button x:Name="ShowAllButton"
                Classes="pill"
                Padding="18,8"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsFilteredEmpty}"
                Command="{Binding ShowAllProfilesCommand}"
                Content="{loc:Loc history.empty.showAll}" />
      </StackPanel>

      <StackPanel x:Name="NoGameState" IsVisible="{Binding HasNoGame}" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="26">
        <TextBlock Classes="card-title" TextAlignment="Center" TextWrapping="Wrap" Text="{loc:Loc history.noGame.title}" />
        <TextBlock Classes="body muted" TextAlignment="Center" TextWrapping="Wrap" Text="{loc:Loc history.noGame.body}" />
      </StackPanel>
    </Panel>
    </common:FloorHeightHost>
  </DockPanel>
  </ScrollViewer>
</UserControl>
