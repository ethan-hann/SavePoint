<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:a11y="using:Savepoint.App.Features.Common.Accessibility"
             xmlns:art="using:Savepoint.App.Features.Common.Art"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             xmlns:search="using:Savepoint.App.Features.Common.Search"
             xmlns:games="using:Savepoint.App.Features.Games"
             x:Class="Savepoint.App.Features.Games.GamesScreenView"
             x:DataType="games:GamesScreenViewModel">
  <!--
    The Games screen (sidebar and library layouts): the game's header, the Profiles / History chips, the profile table, the launch flow's banner or
    running card and the storage footer. The banner or card and the footer are pinned to the bottom of the pane, outside the
    table's scroll area, so a launch's progress is in view however many profiles there are. A failure card is taller, so it
    stays below the table in the scroll area, and so does any card while the pane is too short to pin it. The library layout has no art tile, path, chips or toggle (the shell's shelf
    and top bar carry them), so its header is a title with the same buttons.
  -->
  <UserControl.Resources>
    <!-- One look for every entry of a profile row's menu, used by More actions and by the right-click menu. -->
    <ControlTheme x:Key="ProfileMenuItemTheme" x:DataType="games:ProfileMenuEntry" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="Command" Value="{Binding Command}" />
      <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
      <Setter Property="IsVisible" Value="{Binding IsVisible}" />
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
      <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.profile-dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.profile-dot.active">
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
    </Style>
    <Style Selector="Border.table-row">
      <Setter Property="Focusable" Value="True" />
    </Style>

    <!-- A header too narrow for the game's name and the buttons' words keeps the icons: the names stay on the buttons and appear as tooltips. -->
    <Style Selector="Button.header-action">
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Grid.compact Button.header-action">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Grid.compact Button.header-action TextBlock.header-words">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compact TextBlock.toggle-words">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compact Button#EditGameButton, Grid.compact Button#LibraryEditGameButton">
      <Setter Property="ToolTip.Tip" Value="{loc:Loc games.header.editGame}" />
    </Style>
    <Style Selector="Grid.compact Button#NewProfileButton, Grid.compact Button#LibraryNewProfileButton">
      <Setter Property="ToolTip.Tip" Value="{loc:Loc games.header.newProfile}" />
    </Style>
    <Style Selector="Grid.snapshotCompact Button#TakeSnapshotButton">
      <Setter Property="ToolTip.Tip" Value="{loc:Loc games.header.takeSnapshot}" />
    </Style>
    <Style Selector="Grid.compact ListBox#Toggle ListBoxItem" x:DataType="shell:LayoutOption">
      <Setter Property="ToolTip.Tip" Value="{Binding Label}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="22,20,22,20">

    <!-- Header, sidebar layout: art tile, name and install path, then the buttons and the layout toggle. -->
    <Grid x:Name="SidebarHeader" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" IsVisible="{Binding IsSidebarLayout}" Classes.compact="{Binding Header.IsCompact}">
      <art:ArtTile Size="40" GameName="{Binding GameName}" Art="{Binding Art}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="GameNameText" Classes="dialog-title" TextTrimming="CharacterEllipsis" Text="{Binding GameName}" />
        <TextBlock x:Name="InstallPathText" Classes="mono small subtle" TextTrimming="CharacterEllipsis" Text="{Binding InstallPath}" />
      </StackPanel>
      <Button x:Name="EditGameButton" Grid.Column="2" Classes="header-action" Command="{Binding EditGameCommand}" AutomationProperties.Name="{loc:Loc games.header.editGame}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Edit}" />
          <TextBlock Classes="header-words" Text="{loc:Loc games.header.editGame}" />
        </StackPanel>
      </Button>
      <Button x:Name="NewProfileButton" Grid.Column="3" Classes="header-action" Command="{Binding NewProfileCommand}" AutomationProperties.Name="{loc:Loc games.header.newProfile}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Add}" />
          <TextBlock Classes="header-words" Text="{loc:Loc games.header.newProfile}" />
        </StackPanel>
      </Button>
      <Button x:Name="GameMenuButton" Grid.Column="4" Classes="icon" Margin="0,0,12,0" AutomationProperties.Name="{Binding GameMoreActionsName}" ToolTip.Tip="{Binding GameMoreActionsName}">
        <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.MoreVert}" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{loc:Loc games.header.deleteGame}" Command="{Binding DeleteGameCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <shell:LayoutToggleView Grid.Column="5" VerticalAlignment="Center" DataContext="{Binding LayoutToggle}" />
    </Grid>

    <!-- Header, library layout: a title and the same buttons. -->
    <Grid x:Name="LibraryHeader" Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding IsLibraryLayout}" Classes.compact="{Binding Header.IsCompact}">
      <TextBlock x:Name="LibraryTitleText" Classes="card-title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" Text="{Binding LibraryTitle}" />
      <Button x:Name="LibraryEditGameButton" Grid.Column="1" Classes="header-action" Command="{Binding EditGameCommand}" AutomationProperties.Name="{loc:Loc games.header.editGame}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Edit}" />
          <TextBlock Classes="header-words" Text="{loc:Loc games.header.editGame}" />
        </StackPanel>
      </Button>
      <Button x:Name="LibraryNewProfileButton" Grid.Column="2" Classes="header-action" Command="{Binding NewProfileCommand}" AutomationProperties.Name="{loc:Loc games.header.newProfile}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Add}" />
          <TextBlock Classes="header-words" Text="{loc:Loc games.header.newProfile}" />
        </StackPanel>
      </Button>
      <Button x:Name="LibraryGameMenuButton" Grid.Column="3" Classes="icon" AutomationProperties.Name="{Binding GameMoreActionsName}" ToolTip.Tip="{Binding GameMoreActionsName}">
        <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.MoreVert}" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{loc:Loc games.storageFooter.freeUp}" Command="{Binding FreeUp.FreeUpCommand}" />
            <MenuItem Header="{loc:Loc games.header.deleteGame}" Command="{Binding DeleteGameCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Profiles / History / Activity chips. Profiles is this screen, so it stays selected; the others go to their destinations. -->
    <!-- The Take a snapshot button sits at the right end of this row, which has room for it; the library layout has no chips, so the row holds only the button there. -->
    <Grid x:Name="TabRow" Grid.Row="1" ColumnDefinitions="*,Auto" Classes.snapshotCompact="{Binding Header.IsSnapshotCompact}">
      <StackPanel x:Name="Tabs"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="0,12,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsSidebarLayout}"
                  AutomationProperties.Name="{loc:Loc games.header.tabs.ariaLabel}">
        <games:TabChip x:Name="ProfilesChip" Classes="chip" IsChecked="True" Content="{loc:Loc games.header.tabs.profiles}" />
        <games:TabChip x:Name="HistoryChip" Classes="chip" IsChecked="False" Command="{Binding ShowHistoryCommand}" Content="{loc:Loc games.header.tabs.history}" />
        <games:TabChip x:Name="ActivityChip" Classes="chip" IsChecked="False" Command="{Binding ShowActivityCommand}" Content="{loc:Loc games.header.tabs.activity}" />
      </StackPanel>
      <Button x:Name="TakeSnapshotButton"
              Grid.Column="1"
              Classes="header-action"
              Margin="12,12,0,0"
              VerticalAlignment="Center"
              IsVisible="{Binding HasLoadedProfile}"
              Command="{Binding TakeSnapshotCommand}"
              AutomationProperties.Name="{Binding TakeSnapshotText}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.BookmarkAdd}" />
          <TextBlock IsVisible="{Binding !Header.IsSnapshotCompact}" Text="{Binding TakeSnapshotText}" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid x:Name="ProfilesBody" Grid.Row="2" RowDefinitions="Auto,*">
    <!-- Pinned above the table while the pane is tall enough, so a long list of profiles scrolls under it. -->
    <Panel x:Name="PinnedSearchHost" Margin="0,12,0,0" IsVisible="{Binding ShowPinnedSearch}">
      <search:SearchBoxView x:Name="ProfileSearchBox" DataContext="{Binding ProfileSearch}" />
    </Panel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel VerticalAlignment="Top" Spacing="12">
        <!-- In a short pane the same search goes first in the scrolling profiles, so the table keeps all the room. Focusing it brings it into view. -->
        <Panel x:Name="ScrollingSearchHost" IsVisible="{Binding ShowScrollingSearch}">
          <search:SearchBoxView x:Name="ScrollingProfileSearchBox" DataContext="{Binding ProfileSearch}" />
        </Panel>
        <ContentControl x:Name="LoadErrorHost" Content="{Binding LoadError}" IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The first read of a game's profiles: said out loud, so an empty page is never mistaken for lost profiles. -->
        <Border x:Name="LoadingState"
                Classes="panel"
                Padding="24,22"
                IsVisible="{Binding ShowLoading}"
                AutomationProperties.Name="{loc:Loc games.profileTable.loading}"
                AutomationProperties.LiveSetting="Polite">
          <StackPanel Spacing="12">
            <TextBlock Classes="card-title" Text="{loc:Loc games.profileTable.loading}" />
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{loc:Loc games.profileTable.loading}" />
          </StackPanel>
        </Border>

        <!-- The profile table: grid columns 1fr 84 76 86 and an actions column as wide as its widest button, with a 14px gap; the optional columns drop out as the window narrows. -->
        <Border x:Name="Table" Classes="table" IsVisible="{Binding ShowRows}" AutomationProperties.ControlTypeOverride="Table" AutomationProperties.Name="{loc:Loc games.profileTable.automationName}">
          <!-- The actions column is as wide as the widest row's button ("Switch and play" in the current language), and the header follows it. -->
          <StackPanel Grid.IsSharedSizeScope="True">
            <Border x:Name="TableHeader" Classes="table-header" AutomationProperties.ControlTypeOverride="Header">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ProfileActions" />
                </Grid.ColumnDefinitions>
                <!-- While a search narrows the table, the count sits beside the heading so a player scrolled down still sees a filter is on. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="overline-small" Text="{theme:Upper {loc:Loc games.profileTable.column.profile}}" />
                  <TextBlock x:Name="ProfileCountLine" Classes="caption" FontSize="11.5" VerticalAlignment="Center" IsVisible="{Binding ShowProfileCount}" Text="{Binding ProfileCountText}" />
                </StackPanel>
                <TextBlock x:Name="VersionHeader" Grid.Column="1" Classes="overline-small" Width="84" Margin="14,0,0,0" IsVisible="{Binding Columns.ShowVersion}" Text="{theme:Upper {loc:Loc games.profileTable.column.version}}" />
                <TextBlock x:Name="ModFilesHeader" Grid.Column="2" Classes="overline-small" Width="76" Margin="14,0,0,0" IsVisible="{Binding Columns.ShowModFiles}" Text="{theme:Upper {loc:Loc games.profileTable.column.modFiles}}" />
                <TextBlock x:Name="LastPlayedHeader" Grid.Column="3" Classes="overline-small" Width="86" Margin="14,0,0,0" Text="{theme:Upper {loc:Loc games.profileTable.column.lastPlayed}}" />
                <Border Grid.Column="4" Margin="14,0,0,0" />
              </Grid>
            </Border>
            <ItemsControl x:Name="Rows" ItemsSource="{Binding VisibleProfiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="games:ProfileRowViewModel">
                  <Border Classes="table-row"
                          Classes.selected="{Binding IsActive}"
                          AutomationProperties.ControlTypeOverride="DataItem"
                          AutomationProperties.Name="{Binding AutomationName}"
                          AutomationProperties.HelpText="{Binding HelpText}"
                          ToolTip.Tip="{Binding HelpText}">
                    <!-- Right-click, the menu key and Shift+F10 open the same list More actions shows; it is an addition, not a replacement. -->
                    <Border.ContextFlyout>
                      <MenuFlyout Placement="Pointer"
                                  ItemsSource="{Binding MenuEntries}"
                                  ItemContainerTheme="{StaticResource ProfileMenuItemTheme}" />
                    </Border.ContextFlyout>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProfileActions" />
                      </Grid.ColumnDefinitions>
                      <!-- A grid, not a horizontal stack, so a long name is cut short at the column's edge instead of running under the next one. -->
                      <Grid x:Name="ProfileNameCell" ColumnDefinitions="Auto,*">
                        <Border Classes="profile-dot" Classes.active="{Binding IsActive}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock FontSize="10.5"
                                     TextTrimming="CharacterEllipsis"
                                     Classes.accent="{Binding IsActiveLine}"
                                     Classes.error="{Binding IsUnsavedLine}"
                                     Classes.subtle="{Binding IsPlainLine}"
                                     IsVisible="{Binding SecondaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Text="{Binding SecondaryText}" />
                          <!-- The player's own note, cut at two lines; the whole text is in the tip. -->
                          <TextBlock x:Name="NotesText"
                                     Classes="subtle"
                                     FontSize="10.5"
                                     Margin="0,2,0,0"
                                     TextWrapping="Wrap"
                                     MaxLines="2"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasNotes}"
                                     ToolTip.Tip="{Binding NotesTip}"
                                     Text="{Binding NotesText}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Column="1" Width="84" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Columns.ShowVersion}" Text="{Binding VersionText}" />
                      <TextBlock Grid.Column="2" Width="76" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Columns.ShowModFiles}" Text="{Binding ModFilesText}" />
                      <TextBlock Grid.Column="3" Width="86" Margin="14,0,0,0" VerticalAlignment="Center" Text="{Binding LastPlayedText}" />
                      <Grid Grid.Column="4" Margin="14,0,0,0" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto">
                        <Button x:Name="PlayButton"
                                Grid.Column="0"
                                Classes="row"
                                Classes.filled="{Binding IsActive}"
                                Padding="14,6"
                                Command="{Binding PlayCommand}"
                                ToolTip.Tip="{Binding PlayDisabledReason}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding PlayAutomationName}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon s16" Text="{x:Static theme:Icons.PlayArrow}" />
                            <TextBlock Text="{Binding PlayLabel}" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton"
                                Grid.Column="1"
                                Classes="icon"
                                Margin="6,0,0,0"
                                MinWidth="32"
                                MinHeight="32"
                                AutomationProperties.Name="{Binding MoreActionsAutomationName}"
                                ToolTip.Tip="{Binding MoreActionsAutomationName}">
                          <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.MoreVert}" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight"
                                        ItemsSource="{Binding MenuEntries}"
                                        ItemContainerTheme="{StaticResource ProfileMenuItemTheme}" />
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- A search that matches no profile. -->
        <StackPanel x:Name="NoProfileMatches" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowNoProfileMatches}">
          <TextBlock Classes="body subtle" VerticalAlignment="Center" Text="{Binding NoProfileMatchesText}" />
          <Button x:Name="ProfileClearSearchButton" Classes="text pill" Padding="10,4" Command="{Binding ProfileSearch.ClearCommand}" Content="{loc:Loc search.clear}" />
        </StackPanel>

        <!-- A game with no profiles yet. -->
        <Border x:Name="EmptyState" Classes="panel" Padding="32,36" IsVisible="{Binding ShowEmptyState}">
          <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="420">
            <Border Width="56" Height="56" HorizontalAlignment="Center" CornerRadius="16" Background="{DynamicResource Md3SurfaceContainerBrush}">
              <TextBlock Classes="icon s28 accent" HorizontalAlignment="Center" Text="{x:Static theme:Icons.BookmarkAdd}" />
            </Border>
            <TextBlock Classes="section-title" TextAlignment="Center" Text="{loc:Loc games.profileTable.emptyTitle}" />
            <TextBlock Classes="body muted" TextAlignment="Center" TextWrapping="Wrap" Text="{loc:Loc games.profileTable.empty}" />
            <Button x:Name="EmptyNewProfileButton" Classes="filled pill large" HorizontalAlignment="Center" Command="{Binding NewProfileCommand}" AutomationProperties.Name="{loc:Loc games.header.newProfile}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Add}" />
                <TextBlock Classes="header-words" Text="{loc:Loc games.header.newProfile}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- A failure or partial-result card for this game, below the table where it can use the pane's height; so is a launch card in a pane too short to pin it. -->
        <ContentControl x:Name="ScrollingContentHost" IsVisible="{Binding HasScrollingContent}" Content="{Binding ScrollingContent}" />
      </StackPanel>
    </ScrollViewer>
    </Grid>

    <!-- The launch flow's banner or running card for this game, pinned above the storage footer while the pane has room. -->
    <ContentControl x:Name="InlineContentHost" Grid.Row="3" Margin="0,12,0,0" IsVisible="{Binding HasPinnedContent}" Content="{Binding PinnedContent}" />

    <!-- The storage footer, pinned to the bottom of the pane; the library layout's shelf already shows each game's size. -->
    <Border x:Name="StorageFooter" Grid.Row="4" Classes="strip" Margin="0,12,0,0" IsVisible="{Binding ShowStorageFooter}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Classes="icon muted" VerticalAlignment="Center" Text="{x:Static theme:Icons.Database}" />
        <a11y:AnnouncementRegion x:Name="FreeUpAnnouncer" HorizontalAlignment="Left" Message="{Binding FreeUp.Announcement}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock x:Name="StorageFooterText" Classes="muted" TextWrapping="Wrap" Text="{Binding StorageFooterText}" />
          <TextBlock x:Name="FreeUpStatusText" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding FreeUp.HasStatus}" Text="{Binding FreeUp.StatusText}" />
          <ProgressBar x:Name="FreeUpBar"
                       Height="4"
                       MinHeight="4"
                       IsIndeterminate="True"
                       IsVisible="{Binding FreeUp.IsRunning}"
                       AutomationProperties.Name="{Binding FreeUp.StatusText}" />
        </StackPanel>
        <Button x:Name="FreeUpButton"
                Grid.Column="2"
                Classes="pill"
                Padding="14,6"
                Command="{Binding FreeUp.FreeUpCommand}"
                Content="{loc:Loc games.storageFooter.freeUp}"
                AutomationProperties.Name="{Binding FreeUp.Name}"
                AutomationProperties.HelpText="{loc:Loc games.storageFooter.freeUpHelp}"
                ToolTip.Tip="{loc:Loc games.storageFooter.freeUpHelp}" />
      </Grid>
    </Border>

    <!-- Room for the job pill under the pinned content; the root's bottom margin already counts toward it. -->
    <Border x:Name="PillRoom" Grid.Row="5" Classes="pill-room" Margin="0,0,0,-20" />
  </Grid>
</UserControl>
