<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:art="using:Savepoint.App.Features.Common.Art"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             xmlns:search="using:Savepoint.App.Features.Common.Search"
             x:Class="Savepoint.App.Features.Shell.ShellView"
             x:DataType="shell:ShellViewModel">
  <!--
    The app shell. One content region is shared by both layouts: the sidebar layout adds a rail beside it, the library
    layout adds a top bar and a shelf above it, so changing layout never rebuilds a screen.
  -->
  <UserControl.Styles>
    <Style Selector="ListBox.shelf">
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="12" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusCard}" />
      <Setter Property="Background" Value="{DynamicResource Md3CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Md3BorderThin}" />
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem /template/ Border#PART_Selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem:selected /template/ Border#PART_SelectedRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The nav item style sets its own text color, which would otherwise win over the disabled one. -->
    <Style Selector="ListBox.nav ListBoxItem:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Md3DisabledContentBrush}" />
    </Style>
    <!-- A short window has no room for the shelf's art: the cards keep their names and counts. -->
    <Style Selector="Grid.short ListBox.shelf Border.art-tile">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The shelf's header row is as tall as its text buttons, so its search box is a slimmer field, and a short window keeps its room for the page. -->
    <Style Selector="search|SearchBoxView#ShelfSearch TextBox">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The wide rail gives the label room from the button's edge; the icon rail has none to spare. -->
    <Style Selector="Button.rail-library">
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.rail-library.compact">
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="ShellRoot" ColumnDefinitions="Auto,*" Classes.short="{Binding IsShort}">

    <!-- Sidebar layout: the rail. Below 900px it collapses to icons; names become tooltips and automation names. -->
    <Border x:Name="Rail"
            Classes="rail"
            Width="{Binding RailWidth}"
            Padding="10,14,10,12"
            IsVisible="{Binding IsSidebarLayout}"
            AutomationProperties.LandmarkType="Navigation">
      <Grid RowDefinitions="*,Auto">
        <!-- The list of games scrolls with the rest of the rail's top part, so a long library never pushes Add a game out of the window. -->
        <ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <StackPanel x:Name="RailBrand" Orientation="Horizontal" Spacing="9" Margin="8,2,8,8">
              <shell:BrandMark />
              <TextBlock Classes="row-title" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding !IsCompact}" Text="{loc:Loc app.name}" />
            </StackPanel>
            <ListBox x:Name="NavList"
                     Classes="nav"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Nav}"
                     SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding NavLabel}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="shell:NavItemViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                  <Setter Property="ToolTip.Tip" Value="{Binding ToolTipText}" />
                  <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:NavItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="11">
                    <TextBlock Classes="icon s18" Text="{Binding Icon}" />
                    <TextBlock VerticalAlignment="Center" IsVisible="{Binding ShowLabel}" Text="{Binding Label}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="divider" Margin="8,6,8,4" />
            <TextBlock x:Name="YourGamesLabel" Classes="overline-small" Margin="8,6,8,2" IsVisible="{Binding !IsCompact}" Text="{theme:Upper {loc:Loc shell.yourGames}}" />
            <TextBlock x:Name="NoGamesLabel" Classes="body subtle" Margin="8,2" IsVisible="{Binding ShowFirstRun}" Text="{loc:Loc shell.noGamesYet}" />
            <!-- The search box has no room in the icon rail, so it hides there. -->
            <Panel IsVisible="{Binding ShowRailSearch}" Margin="0,2,0,4">
              <search:SearchBoxView x:Name="RailSearch" DataContext="{Binding GameSearch}" />
            </Panel>
            <StackPanel x:Name="RailNoMatches" Margin="8,2" Spacing="4" IsVisible="{Binding ShowNoGameMatches}">
              <TextBlock Classes="body subtle" TextWrapping="Wrap" Text="{Binding NoGameMatchesText}" />
              <Button Classes="text pill" HorizontalAlignment="Left" Padding="10,4" Command="{Binding GameSearch.ClearCommand}" Content="{loc:Loc search.clear}" />
            </StackPanel>
            <shell:GameListBox x:Name="RailGames"
                     Classes="rows"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{loc:Loc shell.yourGames}"
                     ItemsSource="{Binding VisibleGames}"
                     SelectedItem="{Binding SelectedGameRow, Mode=TwoWay}">
              <shell:GameListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="shell:GameRowViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                  <Setter Property="ToolTip.Tip" Value="{Binding ToolTipText}" />
                </Style>
              </shell:GameListBox.Styles>
              <shell:GameListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:GameRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <art:ArtTile Size="24" GameName="{Binding Name}" Art="{Binding Art}" ShowInitials="{Binding !ShowLabels}" />
                    <StackPanel VerticalAlignment="Center" IsVisible="{Binding ShowLabels}">
                      <TextBlock Classes="body" FontWeight="Medium" FontSize="12.5" LineHeight="16" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock Classes="overline-small" FontWeight="Normal" LetterSpacing="0" Text="{Binding ProfileCountText}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </shell:GameListBox.ItemTemplate>
            </shell:GameListBox>
          </StackPanel>
        </ScrollViewer>
        <!-- Declared after the lists so Tab reaches it after them, where it is drawn. -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
          <Button x:Name="RailLibrariesButton"
                  Classes="pill rail-library"
                  Classes.compact="{Binding IsCompact}"
                  HorizontalAlignment="Stretch"
                  FontSize="13.5"
                  Command="{Binding AddFromLibrariesCommand}"
                  AutomationProperties.Name="{loc:Loc library.entry}"
                  ToolTip.Tip="{loc:Loc library.entry.hint}">
            <!-- A grid, not a row, so a long label wraps inside the button instead of running past it. -->
            <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center">
              <TextBlock Classes="icon s18" VerticalAlignment="Center" Text="{x:Static theme:Icons.StadiaController}" />
              <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !IsCompact}" Text="{loc:Loc library.entry}" />
            </Grid>
          </Button>
          <Button x:Name="RailAddButton"
                  Classes="pill"
                  Classes.filled="{Binding ShowFirstRun}"
                  HorizontalAlignment="Stretch"
                  Padding="12,8"
                  FontSize="13.5"
                  Command="{Binding AddGameCommand}"
                  AutomationProperties.Name="{loc:Loc shell.addGame}"
                  ToolTip.Tip="{loc:Loc shell.addGame}">
            <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center">
              <TextBlock Classes="icon s18" VerticalAlignment="Center" Text="{x:Static theme:Icons.Add}" />
              <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !IsCompact}" Text="{loc:Loc shell.addGame}" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel Grid.Column="1">

      <!-- Library layout: the top bar. -->
      <Border x:Name="TopBar" DockPanel.Dock="Top" Classes="topbar" Height="60" Padding="22,0" IsVisible="{Binding IsLibraryLayout}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <shell:BrandMark />
            <TextBlock Classes="row-title" FontSize="14" VerticalAlignment="Center" Text="{loc:Loc app.name}" />
          </StackPanel>
          <Border Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Md3SurfaceBrush}" CornerRadius="100" Padding="3">
            <ListBox x:Name="TopNavList"
                     Classes="nav horizontal"
                     ItemsSource="{Binding Nav}"
                     SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding NavLabel}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="shell:NavItemViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                  <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                  <Setter Property="Padding" Value="20,5" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:NavItemViewModel">
                  <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <shell:LayoutToggleView Grid.Column="3" VerticalAlignment="Center" DataContext="{Binding LayoutToggle}" />
        </Grid>
      </Border>

      <!-- Library layout: the shelf of games. Games screen only, and only while there are games. -->
      <Border x:Name="Shelf" DockPanel.Dock="Top" IsVisible="{Binding ShowShelf}" Padding="22,16,22,0">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="overline" VerticalAlignment="Center" Text="{theme:Upper {loc:Loc shell.yourGames}}" />
            <search:SearchBoxView x:Name="ShelfSearch" Grid.Column="1" MinWidth="140" Margin="20,0" VerticalAlignment="Center" DataContext="{Binding GameSearch}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button x:Name="ShelfLibrariesButton" Classes="text" Padding="8,4" Command="{Binding AddFromLibrariesCommand}" Content="{loc:Loc library.entry}" ToolTip.Tip="{loc:Loc library.entry.hint}" />
              <Button Classes="text" Padding="8,4" Command="{Binding AddGameCommand}" Content="{loc:Loc shell.addGame}" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="ShelfNoMatches" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowNoGameMatches}">
            <TextBlock Classes="body subtle" VerticalAlignment="Center" Text="{Binding NoGameMatchesText}" />
            <Button Classes="text pill" Padding="10,4" Command="{Binding GameSearch.ClearCommand}" Content="{loc:Loc search.clear}" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto,*">
            <shell:GameListBox x:Name="ShelfGames"
                     Classes="shelf"
                     AutomationProperties.Name="{loc:Loc shell.yourGames}"
                     ItemsSource="{Binding VisibleGames}"
                     SelectedItem="{Binding SelectedGameRow, Mode=TwoWay}">
              <shell:GameListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="shell:GameRowViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                </Style>
              </shell:GameListBox.Styles>
              <shell:GameListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:GameRowViewModel">
                  <StackPanel Width="202">
                    <art:ArtTile Height="74" CornerRadius="13,13,0,0" GameName="{Binding Name}" Art="{Binding Art}" />
                    <StackPanel Margin="14,9,14,10" Spacing="2">
                      <TextBlock Classes="body" FontWeight="Medium" LineHeight="17" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock Classes="timestamp" TextTrimming="CharacterEllipsis" Text="{Binding LibrarySubtitle}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </shell:GameListBox.ItemTemplate>
            </shell:GameListBox>
            <Button x:Name="ShelfAddTile"
                    Grid.Column="1"
                    Classes="dashed tile"
                    Margin="12,0,0,0"
                    Width="202"
                    Command="{Binding AddGameCommand}"
                    AutomationProperties.Name="{loc:Loc shell.addGame}">
              <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="icon s24" HorizontalAlignment="Center" Text="{x:Static theme:Icons.Add}" />
                <TextBlock FontWeight="Normal" FontSize="13" Text="{loc:Loc shell.addGame}" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="divider" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <ContentControl x:Name="ContentRegion" Content="{Binding Content}" AutomationProperties.LandmarkType="Main" />
    </DockPanel>
  </Grid>
</UserControl>
