<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             xmlns:dialogs="using:Savepoint.App.Features.Common.Dialogs"
             x:Class="Savepoint.App.Features.Shell.TemplatePickerView"
             x:DataType="shell:TemplatePickerViewModel">
  <!-- The dialog behind "Start from a template". -->
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Footer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="text pill large" Command="{Binding CancelCommand}" Content="{loc:Loc common.cancel}" />
        <Button Classes="pill large" Command="{Binding OpenFileCommand}" Content="{loc:Loc templatePicker.openFile}" />
      </StackPanel>
    </dialogs:DialogFrame.Footer>
  <StackPanel Spacing="14">
    <TextBlock Classes="dialog-title" TextWrapping="Wrap" Text="{loc:Loc templatePicker.title}" />
    <TextBlock Classes="body muted" TextWrapping="Wrap" Text="{loc:Loc templatePicker.body}" />
    <TextBox x:Name="SearchField"
             Text="{Binding SearchText, Mode=TwoWay}"
             PlaceholderText="{loc:Loc templatePicker.search}"
             AutomationProperties.Name="{loc:Loc templatePicker.search}" />
    <ScrollViewer x:Name="TemplateScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="TemplateList" ItemsSource="{Binding Templates}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:TemplateItem">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="14,10" Command="{Binding Choose}" AutomationProperties.Name="{Binding Name}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.StadiaController}" />
                <TextBlock Classes="body" VerticalAlignment="Center" Text="{Binding Name}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel x:Name="NoMatches" Spacing="8" IsVisible="{Binding ShowNoMatches}">
      <TextBlock x:Name="NoMatchesText" Classes="body muted" AutomationProperties.LiveSetting="Polite" Text="{Binding NoMatchesText}" />
      <Button x:Name="ClearSearchButton" Classes="text pill" HorizontalAlignment="Left" Padding="10,4" Command="{Binding ClearSearchCommand}" Content="{Binding ClearSearchName}" />
    </StackPanel>
  </StackPanel>
  </dialogs:DialogFrame>
</UserControl>
