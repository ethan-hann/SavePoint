<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             x:Class="Savepoint.App.Features.Shell.StartupView"
             x:DataType="shell:StartupViewModel">
  <!-- What the app shows before the shell: the unreadable-file recovery list, or one error card (git unavailable, a failed check, no services). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="26">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="11">
        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Md3PrimaryBrush}">
          <TextBlock Classes="icon s18" HorizontalAlignment="Center" Foreground="{DynamicResource Md3OnPrimaryBrush}" Text="{x:Static theme:Icons.Bookmark}" />
        </Border>
        <TextBlock Classes="row-title" FontSize="16" VerticalAlignment="Center" Text="{loc:Loc app.name}" />
      </StackPanel>

      <TextBlock x:Name="CheckingText" Classes="body muted" HorizontalAlignment="Center" IsVisible="{Binding IsChecking}" Text="{loc:Loc startup.checking}" />

      <ContentControl x:Name="StartupCard" IsVisible="{Binding HasCard}" Content="{Binding Card}" />
      <TextBlock x:Name="LogFolderError" Classes="caption error" TextWrapping="Wrap" IsVisible="{Binding HasLogFolderError}" Text="{Binding LogFolderError}" />

      <StackPanel x:Name="RecoveryList" Spacing="14" IsVisible="{Binding ShowCorruptFiles}">
        <TextBlock Classes="body muted" TextWrapping="Wrap" Text="{loc:Loc startup.corrupt.intro}" />
        <ItemsControl x:Name="RecoveryNotes" ItemsSource="{Binding RecoveryNotes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="caption success" TextWrapping="Wrap" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="RecoveryError" Classes="callout error" IsVisible="{Binding HasRecoveryError}" AutomationProperties.LiveSetting="Polite">
          <TextBlock TextWrapping="Wrap" Text="{Binding RecoveryError}" />
        </Border>
        <ItemsControl x:Name="CorruptFiles" ItemsSource="{Binding CorruptFiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:CorruptFileViewModel">
              <ContentControl Content="{Binding Card}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
