<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             x:Class="Savepoint.App.Features.Shell.FirstRunView"
             x:DataType="shell:FirstRunViewModel">
  <!-- The first-run empty state (mockup 2e). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22" Margin="26">
      <Border x:Name="IconTile"
              Width="64"
              Height="64"
              HorizontalAlignment="Center"
              CornerRadius="16"
              Background="{DynamicResource Md3SurfaceContainerBrush}">
        <TextBlock Classes="icon s28 accent" HorizontalAlignment="Center" Text="{x:Static theme:Icons.Bookmark}" />
      </Border>
      <StackPanel Spacing="12">
        <TextBlock x:Name="TitleText" Classes="page-title" HorizontalAlignment="Center" TextAlignment="Center" Text="{loc:Loc firstRun.title}" />
        <TextBlock x:Name="BodyText"
                   Classes="muted"
                   MaxWidth="460"
                   FontSize="14.5"
                   LineHeight="23"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc firstRun.body}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
        <Button x:Name="AddFirstGameButton" Classes="filled pill large" Padding="24,12" Command="{Binding AddFirstGameCommand}" AutomationProperties.Name="{loc:Loc firstRun.addFirstGame}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Add}" />
            <TextBlock Text="{loc:Loc firstRun.addFirstGame}" />
          </StackPanel>
        </Button>
        <Button x:Name="StartFromTemplateButton" Classes="pill large" Padding="24,12" Command="{Binding StartFromTemplateCommand}" AutomationProperties.Name="{loc:Loc firstRun.startFromTemplate}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Description}" />
            <TextBlock Text="{loc:Loc firstRun.startFromTemplate}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <Border x:Name="StorageNote" Classes="strip" HorizontalAlignment="Center" IsVisible="{Binding HasStorageNote}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Classes="icon muted" Text="{x:Static theme:Icons.Folder}" />
          <TextBlock Grid.Column="1" Classes="caption" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="{Binding StorageNoteBefore}" /><Run FontFamily="{DynamicResource RobotoMonoFont}" Foreground="{DynamicResource Md3OnSurfaceBrush}" Text="{Binding StoragePath}" /><Run Text="{Binding StorageNoteAfter}" />
          </TextBlock>
        </Grid>
      </Border>
      <StackPanel x:Name="ArtworkNote" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding HasArtworkNote}">
        <TextBlock Classes="icon s16 muted" VerticalAlignment="Top" Margin="0,1,0,0" Text="{x:Static theme:Icons.Info}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="480" Text="{loc:Loc firstRun.artworkNote}" />
      </StackPanel>
      <StackPanel x:Name="AntiCheatNote" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <TextBlock Classes="icon s16 muted" VerticalAlignment="Top" Margin="0,1,0,0" Text="{x:Static theme:Icons.Info}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="480" Text="{loc:Loc firstRun.antiCheatNote}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
