<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             x:Class="Savepoint.App.Features.Shell.CloseDuringSnapshotDialogView"
             x:DataType="shell:CloseDuringSnapshotDialogViewModel">
  <!-- Closing would stop the snapshot: minimize to let it finish, close and stop it, or stay. -->
  <StackPanel Spacing="16">
    <TextBlock Classes="dialog-title" TextWrapping="Wrap" Text="{Binding Title}" />
    <TextBlock Classes="body muted" TextWrapping="Wrap" Text="{Binding Message}" />
    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button x:Name="StayButton" Classes="text pill large" Margin="0,0,8,8" Content="{Binding StayLabel}" Command="{Binding StayCommand}" />
      <Button x:Name="CloseButton" Classes="pill large" Margin="0,0,8,8" Content="{Binding CloseLabel}" Command="{Binding CloseAndStopCommand}" />
      <Button x:Name="MinimizeButton" Classes="filled pill large" Margin="0,0,0,8" IsDefault="True" Content="{Binding MinimizeLabel}" Command="{Binding MinimizeCommand}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
