<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="using:Savepoint.App.Features.Common.Accessibility"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             x:Class="Savepoint.App.Features.Shell.JobStatusView"
             x:DataType="shell:JobStatusViewModel">
  <!-- The job pill, shown in both layouts by the window. Pressing it opens Activity. The hidden region speaks the pill's text when it changes. -->
  <Grid x:Name="PillRoot" IsVisible="{Binding IsVisible, FallbackValue=False}">
    <a11y:AnnouncementRegion x:Name="Announcer" Message="{Binding Announcement}" />
    <!-- Capped, with the text trimmed, so a long game name never reaches the actions at the right of a narrow window. -->
    <Button x:Name="Pill"
            Classes="pill"
            MaxWidth="360"
            Background="{DynamicResource Md3SurfaceContainerHighestBrush}"
            Padding="16,9"
            Command="{Binding OpenCommand}"
            AutomationProperties.Name="{Binding OpenName}"
            ToolTip.Tip="{Binding PillText}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <ProgressBar IsIndeterminate="True" Width="34" Height="4" MinHeight="4" VerticalAlignment="Center" AutomationProperties.Name="{Binding PillText}" />
        <TextBlock x:Name="PillText" Grid.Column="1" Classes="body" Foreground="{DynamicResource Md3OnSurfaceBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding PillText}" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
