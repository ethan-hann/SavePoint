<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="using:Savepoint.App.Features.Common.Accessibility"
             xmlns:dialogs="using:Savepoint.App.Features.Common.Dialogs"
             xmlns:toasts="using:Savepoint.App.Features.Common.Toasts"
             xmlns:help="using:Savepoint.App.Features.Help"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             x:Class="Savepoint.App.Features.Shell.MainView"
             x:DataType="shell:MainWindowViewModel">
  <!--
    The window's content: the page (startup screens, then the shell) with the job pill floating over its bottom right corner, so
    the page never moves when a job starts or ends, the toasts in a row of their own below the page so none ever covers a
    control, and the modal overlay above all of it. While a dialog is open the page is hidden from assistive technology.
  -->
  <UserControl.Styles>
    <Style Selector="Panel.dialog-open ContentControl#Page">
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Root" Classes.dialog-open="{Binding Dialogs.IsOpen}">
    <!-- Always present, so a card or banner that appears is spoken: a screen reader only follows changes to elements it already knows. -->
    <a11y:AnnouncementRegion x:Name="PageAnnouncer" />
    <Grid RowDefinitions="*,Auto">
      <ContentControl x:Name="Page" Content="{Binding Content}" />
      <shell:JobStatusView x:Name="JobPill"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="16"
                           DataContext="{Binding Shell.JobStatus}" />
      <!-- The tour's outline and card sit over the page, in the page's own row, and are not there while a dialog or another screen covers the profile table. -->
      <Panel x:Name="TourHost" IsVisible="{Binding ShowTour}">
        <help:TourOverlay x:Name="Tour" DataContext="{Binding Shell.Tour}" />
      </Panel>
      <toasts:ToastHostView x:Name="Toasts" Grid.Row="1" DataContext="{Binding Toasts}" />
    </Grid>
    <dialogs:DialogHostView DataContext="{Binding Dialogs}" />
  </Panel>
</UserControl>
