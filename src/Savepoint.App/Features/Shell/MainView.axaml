<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="using:Savepoint.App.Features.Common.Accessibility"
             xmlns:dialogs="using:Savepoint.App.Features.Common.Dialogs"
             xmlns:toasts="using:Savepoint.App.Features.Common.Toasts"
             xmlns:help="using:Savepoint.App.Features.Help"
             xmlns:shell="using:Savepoint.App.Features.Shell"
             x:Class="Savepoint.App.Features.Shell.MainView"
             x:DataType="shell:MainWindowViewModel">
  <!--
    The window's content: the page (startup screens, then the shell) with the job pill floating over the bottom left corner of
    its content area and the toasts over the bottom right, so the shell never moves when either shows, and the modal overlay
    above all of it. While the pill or a toast shows, the page keeps room under its pinned content (see the code behind), so
    neither covers a control. While a dialog is open the page is hidden from assistive technology.
  -->
  <UserControl.Resources>
    <!-- The pill's height and its margin below, and a little air: the room the page keeps for it. -->
    <x:Double x:Key="PillRoomHeight">64</x:Double>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Panel.dialog-open ContentControl#Page">
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <!-- While the pill shows, a page's scroll area ends with room under its last row (the pill's height and margin, and a little air), so that row can be scrolled clear of the pill. -->
    <Style Selector="Panel.has-room ContentControl#Page ScrollViewer.page-scroll, Panel.has-room ContentControl#Page ListBox.page-scroll">
      <Setter Property="Padding" Value="{DynamicResource PageRoomPadding}" />
    </Style>
    <!-- A screen with content pinned to its bottom edge (a footer, a launch card) ends with a pill-room strip: empty until the pill or a toast shows, then tall enough that the pinned content sits above them instead of under them. -->
    <Style Selector="ContentControl#Page Border.pill-room">
      <Setter Property="Height" Value="0" />
    </Style>
    <Style Selector="Panel.has-room ContentControl#Page Border.pill-room">
      <Setter Property="Height" Value="{DynamicResource PageRoomHeight}" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Root" Classes.dialog-open="{Binding Dialogs.IsOpen}">
    <!-- Always present, so a card or banner that appears is spoken: a screen reader only follows changes to elements it already knows. -->
    <a11y:AnnouncementRegion x:Name="PageAnnouncer" />
    <Grid>
      <ContentControl x:Name="Page" Content="{Binding Content}" />
      <!-- The pill stands in the content area's bottom left corner, past the rail: nothing fixed sits there, while the right hand side holds the actions. -->
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="{Binding Shell.RailWidth, FallbackValue=0}" IsVisible="{Binding Shell.IsSidebarLayout, FallbackValue=False}" />
        <shell:JobStatusView x:Name="JobPill"
                             Grid.Column="1"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="22,0,16,16"
                             DataContext="{Binding Shell.JobStatus}" />
      </Grid>
      <!-- The tour's outline and card sit over the page, in the page's own row, and are not there while a dialog or another screen covers the profile table. -->
      <Panel x:Name="TourHost" IsVisible="{Binding ShowTour}">
        <help:TourOverlay x:Name="Tour" DataContext="{Binding Shell.Tour}" />
      </Panel>
      <toasts:ToastHostView x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" DataContext="{Binding Toasts}" />
    </Grid>
    <dialogs:DialogHostView DataContext="{Binding Dialogs}" />
  </Panel>
</UserControl>
