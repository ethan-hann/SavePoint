<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:editor="using:Savepoint.App.Features.Editor"
             xmlns:art="using:Savepoint.App.Features.Common.Art"
             x:Class="Savepoint.App.Features.Editor.GameEditorView"
             x:DataType="editor:GameEditorViewModel">
  <!--
    The game editor (mockup 2g), a full pane: a header with back, title, Export or Import and Save, then two columns.
    Left: name, install folder, saves folder, files to ignore. Right: how to start the game, how SavePoint knows the
    game stopped, and the folders that hold mods. A problem with a field shows under that field.
  -->
  <UserControl.Styles>
    <Style Selector="TextBox.field">
      <Setter Property="Padding" Value="12,10" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border x:Name="Header" DockPanel.Dock="Top" BorderBrush="{DynamicResource Md3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button x:Name="BackButton"
                  Classes="icon"
                  FontSize="22"
                  Content="{x:Static theme:Icons.ArrowBack}"
                  Command="{Binding BackCommand}"
                  AutomationProperties.Name="{loc:Loc gameEditor.back}"
                  ToolTip.Tip="{loc:Loc gameEditor.back}" />
          <TextBlock x:Name="TitleText" Classes="page-title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button x:Name="ExportButton" Padding="16,8" FontSize="13.5" IsVisible="{Binding CanExport}" Command="{Binding ExportCommand}" AutomationProperties.Name="{loc:Loc gameEditor.export}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Download}" />
              <TextBlock Text="{loc:Loc gameEditor.export}" />
            </StackPanel>
          </Button>
          <Button x:Name="ImportButton" Padding="16,8" FontSize="13.5" IsVisible="{Binding CanImport}" Command="{Binding ImportCommand}" AutomationProperties.Name="{loc:Loc gameEditor.import}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon s18" Text="{x:Static theme:Icons.Upload}" />
              <TextBlock Text="{loc:Loc gameEditor.import}" />
            </StackPanel>
          </Button>
          <Button x:Name="SaveButton" Classes="filled" Padding="18,8" FontSize="13.5" Command="{Binding SaveCommand}" Content="{loc:Loc gameEditor.save}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22" Spacing="16">

        <ContentControl x:Name="FormErrorHost" Content="{Binding FormError}" IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="7*,22,6*">

          <!-- Left column. -->
          <StackPanel Spacing="22">

            <StackPanel Spacing="9">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.name.label}}" />
              <TextBox x:Name="NameField"
                       Classes="field"
                       FontSize="14"
                       Classes.error="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding Name, Mode=TwoWay}"
                       AutomationProperties.Name="{loc:Loc gameEditor.name.label}" />
              <TextBlock x:Name="NameErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding NameError}" />
            </StackPanel>

            <StackPanel Spacing="9">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.install.label}}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="InstallField"
                         Classes="field mono"
                         Classes.error="{Binding InstallError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Text="{Binding InstallPath, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:Loc gameEditor.install.label}" />
                <Button x:Name="BrowseInstallButton"
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Padding="18,0"
                        Command="{Binding BrowseInstallCommand}"
                        Content="{loc:Loc gameEditor.browse}"
                        AutomationProperties.Name="{loc:Loc gameEditor.install.browseAutomation}" />
              </Grid>
              <StackPanel x:Name="InstallConfirmedLine" Orientation="Horizontal" Spacing="8" IsVisible="{Binding InstallConfirmation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="icon s18 accent" Text="{x:Static theme:Icons.VerifiedUser}" />
                <TextBlock Classes="body accent" VerticalAlignment="Center" Text="{Binding InstallConfirmation}" />
              </StackPanel>
              <TextBlock x:Name="InstallErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding InstallError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding InstallError}" />
              <ContentControl x:Name="InstallCardHost" Content="{Binding InstallCard}" IsVisible="{Binding InstallCard, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <StackPanel Spacing="9">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.external.label}}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SavesField"
                         Classes="field mono"
                         Classes.error="{Binding SavesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Text="{Binding SavesPath, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:Loc gameEditor.external.label}" />
                <Button x:Name="BrowseSavesButton"
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Padding="18,0"
                        Command="{Binding BrowseSavesCommand}"
                        Content="{loc:Loc gameEditor.browse}"
                        AutomationProperties.Name="{loc:Loc gameEditor.external.browseAutomation}" />
              </Grid>
              <StackPanel x:Name="SavesConfirmedLine" Orientation="Horizontal" Spacing="8" IsVisible="{Binding SavesConfirmation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="icon s18 accent" Text="{x:Static theme:Icons.VerifiedUser}" />
                <TextBlock Classes="body accent" VerticalAlignment="Center" Text="{Binding SavesConfirmation}" />
              </StackPanel>
              <Grid x:Name="SavesResolvesLine" ColumnDefinitions="Auto,*" IsVisible="{Binding SavesResolves, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="icon s18 muted" Margin="0,0,8,0" Text="{x:Static theme:Icons.Info}" />
                <TextBlock Grid.Column="1" Classes="body muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SavesResolves}" ToolTip.Tip="{Binding SavesResolves}" />
              </Grid>
              <TextBlock x:Name="SavesErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding SavesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding SavesError}" />
              <ContentControl x:Name="SavesCardHost" Content="{Binding SavesCard}" IsVisible="{Binding SavesCard, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Grid x:Name="LocationRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Classes="caption" VerticalAlignment="Top" Margin="0,4,0,0" Text="{loc:Loc gameEditor.external.commonLocations}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding LocationChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="editor:SuggestionItem">
                      <Button Classes="pill" Margin="0,0,6,6" Padding="10,3" FontFamily="{DynamicResource RobotoMonoFont}" FontSize="11.5" FontWeight="Normal" Content="{Binding Display}" ToolTip.Tip="{Binding Text}" Command="{Binding Use}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="9">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.ignorePaths.label}}" />
              <ContentControl x:Name="IgnoreRulesHost" Content="{Binding IgnoreRules}" />
            </StackPanel>

          </StackPanel>

          <!-- Right column. -->
          <StackPanel Grid.Column="2" Spacing="22">

            <StackPanel Spacing="12">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.launch.label}}" />
              <ListBox x:Name="LaunchChoiceList"
                       Classes="choice"
                       SelectedIndex="{Binding LaunchChoice, Mode=TwoWay}"
                       AutomationProperties.Name="{loc:Loc gameEditor.launch.label}">
                <ListBoxItem x:Name="RunExeChoice" Padding="8,10">
                  <TextBlock Text="{Binding RunExeLabel}" />
                </ListBoxItem>
                <ListBoxItem x:Name="SteamChoice" Padding="8,10">
                  <TextBlock Text="{loc:Loc gameEditor.launch.steam}" />
                </ListBoxItem>
              </ListBox>
              <TextBlock x:Name="LaunchErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding LaunchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding LaunchError}" />

              <StackPanel x:Name="ExePanel" Spacing="9" IsVisible="{Binding IsExeMethod}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="ExeField"
                           Classes="field mono"
                           Classes.error="{Binding ExePathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ExePath, Mode=TwoWay}"
                           AutomationProperties.Name="{loc:Loc gameEditor.launch.exePath.ariaLabel}" />
                  <Button x:Name="BrowseExeButton"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          Padding="18,0"
                          Command="{Binding BrowseExeCommand}"
                          Content="{loc:Loc gameEditor.browse}"
                          AutomationProperties.Name="{loc:Loc gameEditor.launch.exeBrowseAutomation}" />
                </Grid>
                <TextBlock x:Name="ExeErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding ExePathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding ExePathError}" />
                <StackPanel x:Name="ExeSuggestionRow" Spacing="6" IsVisible="{Binding HasExeSuggestions}">
                  <TextBlock Classes="caption" Text="{loc:Loc gameEditor.suggestions.found}" />
                  <ItemsControl ItemsSource="{Binding ExeSuggestions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="editor:SuggestionItem">
                        <Button Classes="pill" Margin="0,0,6,6" Padding="10,3" FontFamily="{DynamicResource RobotoMonoFont}" FontSize="11.5" FontWeight="Normal" Content="{Binding Text}" Command="{Binding Use}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="UriPanel" Spacing="9" IsVisible="{Binding IsSteamMethod}">
                <TextBox x:Name="UriField"
                         Classes="field mono"
                         Classes.error="{Binding UriError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Text="{Binding Uri, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc gameEditor.launch.uriPlaceholder}"
                         AutomationProperties.Name="{loc:Loc gameEditor.launch.uri.ariaLabel}" />
                <TextBlock x:Name="UriErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding UriError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding UriError}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:Loc gameEditor.launch.steamHelper}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="{loc:Loc gameEditor.launchArgs.label}" />
                <ContentControl x:Name="LaunchArgsHost" Content="{Binding LaunchArgs}" />
              </StackPanel>

              <Border x:Name="SteamWarningCallout" Classes="callout warning">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Classes="icon s18 warning" VerticalAlignment="Top" Margin="0,1,12,0" Text="{x:Static theme:Icons.Warning}" />
                  <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" Text="{Binding SteamWarning}" />
                </Grid>
              </Border>

              <Border x:Name="GuidanceStrip" Classes="strip">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="icon s16 muted" VerticalAlignment="Top" Margin="0,2,10,0" Text="{x:Static theme:Icons.Info}" />
                    <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{loc:Loc gameEditor.cloudSaves}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="icon s16 muted" VerticalAlignment="Top" Margin="0,2,10,0" Text="{x:Static theme:Icons.Info}" />
                    <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{loc:Loc gameEditor.antiCheat}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="9">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.processName.label}}" />
              <TextBox x:Name="ProcessField"
                       Classes="field mono"
                       Text="{Binding ProcessName, Mode=TwoWay}"
                       AutomationProperties.Name="{loc:Loc gameEditor.processName.label}" />
              <StackPanel x:Name="ProcessSuggestionRow" Spacing="6" IsVisible="{Binding HasProcessSuggestions}">
                <TextBlock Classes="caption" Text="{loc:Loc gameEditor.suggestions.found}" />
                <ItemsControl ItemsSource="{Binding ProcessSuggestions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="editor:SuggestionItem">
                      <Button Classes="pill" Margin="0,0,6,6" Padding="10,3" FontFamily="{DynamicResource RobotoMonoFont}" FontSize="11.5" FontWeight="Normal" Content="{Binding Text}" Command="{Binding Use}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Classes="body muted" TextWrapping="Wrap" Text="{loc:Loc gameEditor.processName.helper}" />
            </StackPanel>

            <StackPanel Spacing="9">
              <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.modPathHints.label}}" />
              <ContentControl x:Name="ModFoldersHost" Content="{Binding ModFolders}" />
              <TextBlock Classes="body muted" TextWrapping="Wrap" Text="{loc:Loc gameEditor.modPathHints.helper}" />
            </StackPanel>

          </StackPanel>
        </Grid>

        <!-- Artwork: how the game looks in the library, where that comes from, and the Steam app id the lookup uses. -->
        <StackPanel x:Name="ArtworkSection" Spacing="9" IsVisible="{Binding HasArtworkSection}">
          <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.artwork.label}}" />
          <Border Classes="panel">
            <Grid ColumnDefinitions="Auto,24,*">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                <art:ArtTile x:Name="ArtworkCardPreview" Width="184" Height="86" CornerRadius="13" GameName="{Binding Name}" Art="{Binding ArtworkPreview}" />
                <art:ArtTile x:Name="ArtworkSquarePreview" Width="86" Height="86" CornerRadius="8" GameName="{Binding Name}" Art="{Binding ArtworkPreview}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="14">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="ArtworkSourceText" Classes="row-title" Text="{Binding ArtworkSourceText}" AutomationProperties.LiveSetting="Polite" />
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ChooseImageButton" Margin="0,0,10,8" Padding="16,8" FontSize="13.5" Command="{Binding ChooseImageCommand}" Content="{loc:Loc gameEditor.artwork.choose}" />
                    <Button x:Name="RemoveImageButton" Margin="0,0,10,8" Padding="16,8" FontSize="13.5" IsVisible="{Binding CanRemoveImage}" Command="{Binding RemoveImageCommand}" Content="{loc:Loc gameEditor.artwork.remove}" />
                    <Button x:Name="LookAgainButton" Margin="0,0,10,8" Padding="16,8" FontSize="13.5" Command="{Binding LookAgainCommand}" Content="{loc:Loc gameEditor.artwork.lookAgain}" />
                  </WrapPanel>
                  <TextBlock x:Name="LookingText" Classes="caption" IsVisible="{Binding IsLookingAgain}" Text="{loc:Loc gameEditor.artwork.looking}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="LookAgainWaitsText" Classes="caption" IsVisible="{Binding LookAgainWaitsForSave}" Text="{loc:Loc gameEditor.artwork.appId.saveFirst}" />
                  <ContentControl x:Name="ArtworkErrorHost" Content="{Binding ArtworkError}" IsVisible="{Binding ArtworkError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Spacing="9">
                  <TextBlock Classes="overline" Text="{theme:Upper {loc:Loc gameEditor.artwork.appId.label}}" />
                  <TextBox x:Name="SteamAppIdField"
                           Classes="field mono"
                           Width="200"
                           HorizontalAlignment="Left"
                           Classes.error="{Binding SteamAppIdError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding SteamAppIdText, Mode=TwoWay}"
                           PlaceholderText="{Binding SteamAppIdHint}"
                           AutomationProperties.Name="{loc:Loc gameEditor.artwork.appId.label}" />
                  <TextBlock x:Name="SteamAppIdErrorText" Classes="body error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding SteamAppIdError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding SteamAppIdError}" />
                  <TextBlock Classes="body muted" TextWrapping="Wrap" Text="{loc:Loc gameEditor.artwork.appId.helper}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
