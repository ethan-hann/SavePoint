<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:editor="using:Savepoint.App.Features.Editor"
             x:Class="Savepoint.App.Features.Editor.ChipListView"
             x:DataType="editor:ChipListViewModel">
  <!--
    Removable monospace chips in one wrapping row, ending with the dashed add chip, which turns into a text field.
    The list lays out its entries: each chip, then the list itself as the add chip.
  -->
  <ItemsControl x:Name="Chips" ItemsSource="{Binding Entries}" AutomationProperties.Name="{Binding GroupName}" AutomationProperties.HelpText="{Binding HelpText}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.DataTemplates>
      <DataTemplate x:DataType="editor:ChipItem">
        <Panel Margin="0,0,8,8">
          <Border Classes="input-chip" IsVisible="{Binding !IsEditing}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <!-- The chip's text is the edit target: Enter or F2 while it has focus, or a double-click, turns it into a field. -->
              <Border x:Name="ChipText"
                      Focusable="True"
                      Background="Transparent"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding EditLabel}"
                      AutomationProperties.HelpText="{Binding EditHint}"
                      AutomationProperties.ControlTypeOverride="Button">
                <Border.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding BeginEditCommand}" />
                  <KeyBinding Gesture="F2" Command="{Binding BeginEditCommand}" />
                </Border.KeyBindings>
                <TextBlock VerticalAlignment="Center" Text="{Binding Text}" />
              </Border>
              <!-- A 32px target that sticks out of the chip by 4px, so the chip keeps its height. -->
              <Button Classes="icon"
                      Margin="0,-4,-4,-4"
                      MinWidth="32"
                      MinHeight="32"
                      FontSize="14"
                      Content="{x:Static theme:Icons.Close}"
                      Command="{Binding Remove}"
                      AutomationProperties.Name="{Binding RemoveLabel}" />
            </StackPanel>
          </Border>
          <editor:ChipEntryBox x:Name="ChipEdit"
                               Classes="mono"
                               Width="200"
                               Padding="12,6"
                               IsVisible="{Binding IsEditing}"
                               Text="{Binding EditText, Mode=TwoWay}"
                               CommitCommand="{Binding CommitEditCommand}"
                               AutomationProperties.Name="{Binding EditFieldLabel}">
            <editor:ChipEntryBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CommitEditCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
            </editor:ChipEntryBox.KeyBindings>
          </editor:ChipEntryBox>
        </Panel>
      </DataTemplate>
      <DataTemplate x:DataType="editor:ChipListViewModel">
        <Panel Margin="0,0,8,8">
          <Button x:Name="AddChip" Classes="dashed pill" Padding="10,5" IsVisible="{Binding !IsAdding}" Command="{Binding BeginAddCommand}" AutomationProperties.Name="{Binding AddAutomationName}" AutomationProperties.HelpText="{Binding HelpText}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon s14" Text="{x:Static theme:Icons.Add}" />
              <TextBlock Text="{Binding AddLabel}" />
            </StackPanel>
          </Button>
          <editor:ChipEntryBox x:Name="AddField"
                               Classes="mono"
                               Width="200"
                               Padding="12,6"
                               IsVisible="{Binding IsAdding}"
                               Text="{Binding NewText, Mode=TwoWay}"
                               PlaceholderText="{Binding Placeholder}"
                               CommitCommand="{Binding CommitAddCommand}"
                               AutomationProperties.Name="{Binding AddAutomationName}"
                               AutomationProperties.HelpText="{Binding HelpText}">
            <editor:ChipEntryBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CommitAddCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
            </editor:ChipEntryBox.KeyBindings>
          </editor:ChipEntryBox>
        </Panel>
      </DataTemplate>
    </ItemsControl.DataTemplates>
  </ItemsControl>
</UserControl>
