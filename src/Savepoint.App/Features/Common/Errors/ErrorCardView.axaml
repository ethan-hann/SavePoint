<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:errors="using:Savepoint.App.Features.Common.Errors"
             x:Class="Savepoint.App.Features.Common.Errors.ErrorCardView"
             x:DataType="errors:ErrorCardViewModel">
  <!--
    The shared error card: icon and headline, what happened, the path on a recessed monospace surface,
    optional extra content, the actions, and a toggle that explains the technical text and offers to copy it; the text itself is never drawn.
  -->
  <Border x:Name="Card"
          Classes="card"
          Background="{DynamicResource Md3SurfaceContainerHighBrush}"
          Padding="18,16,22,18"
          AutomationProperties.Name="{Binding Title}"
          AutomationProperties.LiveSetting="Polite">
    <Grid ColumnDefinitions="Auto,*">
      <TextBlock x:Name="IconGlyph"
                 Classes="icon s24"
                 Classes.error="{Binding IsError}"
                 Classes.warning="{Binding IsWarning}"
                 Classes.muted="{Binding IsNeutral}"
                 Margin="0,0,12,0"
                 VerticalAlignment="Top"
                 Text="{Binding Icon}" />
      <StackPanel Grid.Column="1" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock x:Name="TitleText" Classes="card-title" TextWrapping="Wrap" Text="{Binding Title}" />
          <TextBlock x:Name="BodyText" Classes="body muted" TextWrapping="Wrap" Text="{Binding Body}" />
        </StackPanel>
        <Border x:Name="PathSurface" Classes="recessed" IsVisible="{Binding HasPath}">
          <SelectableTextBlock FontFamily="{DynamicResource RobotoMonoFont}" FontSize="12" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" TextWrapping="Wrap" Text="{Binding Path}" />
        </Border>
        <ContentControl x:Name="SupplementHost" Content="{Binding Supplement}" IsVisible="{Binding Supplement, Converter={x:Static ObjectConverters.IsNotNull}}">
          <!-- Plain words wrap inside the card; a view model draws its own view. -->
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="x:String">
              <TextBlock TextWrapping="Wrap" Text="{Binding}" />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <!-- The actions wrap to the next line when the card is too narrow for them side by side. -->
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <ItemsControl ItemsSource="{Binding Actions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="errors:ErrorCardAction">
                <Button Classes="pill"
                        Padding="18,8"
                        FontSize="13"
                        Classes.filled="{Binding IsPrimary}"
                        Content="{Binding Label}"
                        Command="{Binding Command}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ToggleButton x:Name="DetailsToggle"
                        Classes="pill"
                        Padding="18,8"
                        FontSize="13"
                        IsVisible="{Binding HasSupportText}"
                        IsChecked="{Binding ShowDetails, Mode=TwoWay}"
                        Content="{Binding DetailsToggleLabel}" />
        </WrapPanel>
        <Border x:Name="DetailsSurface" Classes="recessed" IsVisible="{Binding ShowDetails}">
          <StackPanel Spacing="10">
            <TextBlock x:Name="DetailsExplanation" Classes="body muted" TextWrapping="Wrap" Text="{Binding DetailsExplanation}" />
            <Button x:Name="CopyDetails" Classes="pill" Padding="18,8" FontSize="13" HorizontalAlignment="Left" Content="{Binding CopyDetailsLabel}" Command="{Binding CopyDetailsCommand}" />
            <TextBlock x:Name="CopyNoteText" Classes="caption muted" TextWrapping="Wrap" Text="{Binding CopyNote}" IsVisible="{Binding CopyNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
