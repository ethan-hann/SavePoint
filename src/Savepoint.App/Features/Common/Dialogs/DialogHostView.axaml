<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Savepoint.App.Features.Common.Dialogs"
             x:Class="Savepoint.App.Features.Common.Dialogs.DialogHostView"
             x:DataType="dialogs:DialogHostViewModel">
  <!--
    The modal overlay: a scrim over the whole window and the newest dialog centered on it. Only the dialog's own
    controls take focus (Tab cycles inside it); the window hides the page behind from assistive technology while this is open.
  -->
  <UserControl.Styles>
    <!-- A dialog that pins its footer scrolls its own body, so the host gives it the window's height instead of scrolling it all. -->
    <Style Selector="ScrollViewer#DialogScroll">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ScrollViewer#DialogScroll.pinned">
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- A dialog's own view is a user control, which clips to its bounds and would cut the focus ring off a button at its edge. -->
    <Style Selector="ContentControl#DialogContent > :is(UserControl)">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Overlay" IsVisible="{Binding IsOpen}">
    <Border x:Name="Scrim" Classes="scrim" />
    <Border x:Name="Chrome"
            Classes="dialog"
            Width="{Binding Current.DialogWidth, FallbackValue=440}"
            AutomationProperties.Name="{Binding Current.Title}"
            AutomationProperties.HelpText="{Binding Current.Description}"
            AutomationProperties.ControlTypeOverride="Window"
            KeyboardNavigation.TabNavigation="Cycle">
      <!-- The scroll viewer clips to its viewport, which would cut the focus ring off buttons at the dialog's edge; the content's margin gives the ring room inside the viewport and the viewer's negative margin puts the content back where it was. -->
      <ScrollViewer x:Name="DialogScroll" Margin="{DynamicResource Md3DialogRingOutset}" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Classes.pinned="{Binding Current.PinsFooter}">
        <ContentControl x:Name="DialogContent" Margin="{DynamicResource Md3DialogRingRoom}" ClipToBounds="False" Content="{Binding Current}" />
      </ScrollViewer>
    </Border>
  </Panel>
</UserControl>
