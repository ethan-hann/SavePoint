<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Savepoint.App.Localization"
             xmlns:theme="using:Savepoint.App.Theme"
             xmlns:a11y="using:Savepoint.App.Features.Common.Accessibility"
             xmlns:dialogs="using:Savepoint.App.Features.Common.Dialogs"
             xmlns:launch="using:Savepoint.App.Features.Launch"
             xmlns:help="using:Savepoint.App.Features.Help"
             x:Class="Savepoint.App.Features.Launch.LaunchDialogView"
             x:DataType="launch:LaunchDialogViewModel">
  <!-- The launch dialog: what will change, which save loads, and anything unsaved that has to be dealt with first. -->
  <UserControl.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Md3CardBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusPanel}" />
      <Setter Property="Padding" Value="18,14" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="SaveOptionTemplate" x:DataType="launch:SaveOptionViewModel">
      <StackPanel Spacing="1">
        <TextBlock FontSize="14.5" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- With every section showing, the dialog is taller than a small window: the sections scroll and the buttons stay in view below them. -->
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Footer>
      <Grid ColumnDefinitions="*,Auto">
        <CheckBox x:Name="DontAskAgainBox"
                  VerticalAlignment="Center"
                  IsChecked="{Binding DontAskAgain, Mode=TwoWay}"
                  Content="{loc:Loc launch.dialog.dontAskAgain}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Classes="text pill large" Command="{Binding CancelCommand}" Content="{loc:Loc common.cancel}" />
          <Button x:Name="SwitchButton"
                  Classes="filled pill large"
                  IsDefault="True"
                  Command="{Binding SwitchCommand}"
                  Content="{loc:Loc launch.dialog.switchAndPlay}" />
        </StackPanel>
      </Grid>
    </dialogs:DialogFrame.Footer>
    <StackPanel Spacing="12">
      <StackPanel Spacing="8" Margin="0,0,0,12">
        <TextBlock x:Name="TitleText" Classes="dialog-title" TextWrapping="Wrap" Text="{Binding Title}" />
        <TextBlock x:Name="SubtitleText" Classes="body muted" FontSize="14" TextWrapping="Wrap" Text="{Binding Subtitle}" />
      </StackPanel>

      <Border x:Name="OlderPointNote" Classes="strip" IsVisible="{Binding IsOlderPoint}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="icon accent" VerticalAlignment="Top" Text="{x:Static theme:Icons.History}" />
          <TextBlock Classes="caption" FontSize="13" MaxWidth="470" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding OlderPointText}" />
        </StackPanel>
      </Border>

      <Border x:Name="VersionSection" Classes="section" IsVisible="{Binding HasVersionSection}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="icon accent" VerticalAlignment="Top" Margin="0,1,16,0" Text="{x:Static theme:Icons.SwapHoriz}" />
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="card-heading" Text="{loc:Loc launch.dialog.versionTitle}" />
            <TextBlock x:Name="VersionText" Classes="muted" FontSize="13.5" LineHeight="20" TextWrapping="Wrap">
              <Run Text="{Binding VersionBefore}" /><Run FontWeight="Bold" Foreground="{DynamicResource Md3OnSurfaceBrush}" Text="{Binding VersionTarget}" /><Run Text="{Binding VersionAfter}" />
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="SaveSection" Classes="section" IsVisible="{Binding HasSaveSection}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="icon accent" VerticalAlignment="Top" Margin="0,1,16,0" Text="{x:Static theme:Icons.Save}" />
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="card-heading" Text="{loc:Loc launch.dialog.saveTitle}" />
            <ComboBox x:Name="SavePicker"
                      ItemsSource="{Binding SaveOptions}"
                      SelectedItem="{Binding SelectedSave, Mode=TwoWay}"
                      ItemTemplate="{StaticResource SaveOptionTemplate}"
                      IsVisible="{Binding HasSaveChoice}"
                      AutomationProperties.Name="{loc:Loc launch.dialog.saveTitle}" />
            <ContentControl x:Name="SingleSave"
                            Content="{Binding SelectedSave}"
                            ContentTemplate="{StaticResource SaveOptionTemplate}"
                            IsVisible="{Binding !HasSaveChoice}" />
            <TextBlock x:Name="SaveCaptionText" Classes="body muted" TextWrapping="Wrap" Text="{Binding SaveCaption}" />
            <help:ContextualHelpView x:Name="SaveSnapshotHelpHost" DataContext="{Binding SaveSnapshotHelp}" />
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl x:Name="UnsavedList" ItemsSource="{Binding UnsavedBlocks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="launch:UnsavedChangesBlockViewModel">
            <Border Classes="callout error" Padding="18,14" AutomationProperties.Name="{Binding Title}">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="icon error" VerticalAlignment="Top" Margin="0,1,14,0" Text="{x:Static theme:Icons.Error}" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="card-heading" TextWrapping="Wrap" Text="{Binding Title}" />
                  <TextBlock Classes="body" FontSize="13.5" LineHeight="20" TextWrapping="Wrap" Text="{Binding Body}" />
                  <StackPanel IsVisible="{Binding HasHelp}">
                    <help:ContextualHelpView DataContext="{Binding Help}" />
                  </StackPanel>
                  <TextBlock Classes="body"
                             FontWeight="Medium"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasError}"
                             AutomationProperties.LiveSetting="Assertive"
                             Text="{Binding Error}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding ShowActions}">
                    <Button Classes="error pill" FontSize="13.5" Padding="16,8" IsVisible="{Binding CanSaveFirst}" Command="{Binding SaveFirstCommand}" Content="{loc:Loc launch.dialog.saveThemFirst}" />
                    <Button Classes="filled pill" FontSize="13.5" Padding="16,8" IsVisible="{Binding CanFinishSwitch}" Command="{Binding FinishSwitchCommand}" Content="{loc:Loc launch.dialog.finishSwitch}" />
                    <Button Classes="error-outlined pill" FontSize="13.5" Padding="16,8" Command="{Binding DiscardCommand}" Content="{loc:Loc launch.dialog.discardThem}" />
                  </StackPanel>
                  <!-- While "Take a snapshot first" runs the bar takes the buttons' place; saving can take minutes. -->
                  <StackPanel x:Name="SavingProgress" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsSaving}">
                    <a11y:AnnouncementRegion Message="{Binding Announcement}" />
                    <TextBlock Classes="body" FontWeight="Medium" Text="{loc:Loc launch.dialog.savingFirst}" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 AutomationProperties.Name="{loc:Loc launch.dialog.savingFirst}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ProgressText}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border x:Name="KeepCallout" Classes="callout warning" Padding="18,14" IsVisible="{Binding ShowKeepCallout}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="icon warning" VerticalAlignment="Top" Margin="0,1,14,0" Text="{x:Static theme:Icons.Info}" />
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="body" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Text="{Binding KeepText}" />
            <Button x:Name="KeepButton" Classes="filled pill" Command="{Binding KeepCommand}" Content="{loc:Loc launch.dialog.keepAction}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </dialogs:DialogFrame>
</UserControl>
