<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Savepoint.App.Theme">

  <!--
    Button. Variants are style classes: outlined (the default), filled, tonal, text, error, error-outlined.
    Modifiers combine with any variant: pill, row (table-row size), large (dialog footer size), icon (icon-only),
    dashed (dashed outline), tile (card-sized add tile). Every state change is an overlay in the content color,
    so hover, press and focus read the same on every variant. Keyboard focus draws a 2px primary ring 2px outside.
    An icon-only button must carry AutomationProperties.Name.
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Md3BorderThin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusControl}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Md3FocusRingNone}" />
    <!-- Templated controls clip to their bounds by default, which would cut off the focus ring. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <Rectangle x:Name="PART_Dashes"
                         IsVisible="False"
                         IsHitTestVisible="False"
                         Stroke="{DynamicResource Md3OutlineVariantBrush}"
                         StrokeThickness="1"
                         StrokeDashArray="3,3"
                         RadiusX="8"
                         RadiusY="8" />
              <Border x:Name="PART_StateLayer"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False"
                      Transitions="{DynamicResource Md3TransitionsOpacityShort}" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Panel>
          </Border>
          <Border x:Name="PART_FocusRing"
                  Margin="-4"
                  BorderBrush="{DynamicResource Md3PrimaryBrush}"
                  BorderThickness="2"
                  CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static theme:ShapeConverters.InflateCornerRadius}, ConverterParameter=4}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource Md3OpacityHover}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource Md3OpacityFocus}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource Md3OpacityPressed}" />
    </Style>

    <!-- Outlined is the default look; text and the container variants override it below. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Md3DisabledContentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3DisabledContainerBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="^.text">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="^.filled">
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.tonal">
      <Setter Property="Background" Value="{DynamicResource Md3SecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSecondaryContainerBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource Md3ErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnErrorBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.error-outlined">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnErrorContainerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3ErrorCalloutBorderBrush}" />
    </Style>
    <Style Selector="^.filled:disabled, ^.tonal:disabled, ^.error:disabled">
      <Setter Property="Background" Value="{DynamicResource Md3DisabledContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3DisabledContentBrush}" />
    </Style>

    <Style Selector="^.pill">
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusPill}" />
    </Style>
    <Style Selector="^.row">
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusSmall}" />
      <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="22,10" />
    </Style>
    <Style Selector="^.large.text">
      <Setter Property="Padding" Value="20,10" />
    </Style>

    <Style Selector="^.icon">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusPill}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontFamily" Value="{DynamicResource SymbolsFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- A dashed outline instead of a solid one: the "add" chip and the add-a-game tile. -->
    <Style Selector="^.dashed">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.dashed /template/ Rectangle#PART_Dashes">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.dashed.pill /template/ Rectangle#PART_Dashes">
      <Setter Property="RadiusX" Value="{Binding $self.Bounds.Height, Converter={x:Static theme:ShapeConverters.Half}}" />
      <Setter Property="RadiusY" Value="{Binding $self.Bounds.Height, Converter={x:Static theme:ShapeConverters.Half}}" />
    </Style>
    <Style Selector="^.tile">
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusCard}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^.tile.dashed /template/ Rectangle#PART_Dashes">
      <Setter Property="RadiusX" Value="14" />
      <Setter Property="RadiusY" Value="14" />
    </Style>
  </ControlTheme>

  <!-- ToggleButton: the Button look, plus a filled primaryContainer checked state. The chip class makes a filter chip. -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryContainerBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^.chip">
      <Setter Property="CornerRadius" Value="{DynamicResource Md3RadiusPill}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="^.chip:checked">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryContainerBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Md3DisabledContentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3DisabledContainerBrush}" />
    </Style>
    <Style Selector="^:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource Md3DisabledContainerBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
