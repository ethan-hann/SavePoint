<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Savepoint.App.Localization"
        xmlns:shell="using:Savepoint.App.Features.Shell"
        x:Class="Savepoint.App.Views.MainWindow"
        Title="{loc:Loc app.name}"
        Width="1040"
        Height="660"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <!-- The player's UI scale: everything in the window is laid out at that size, so nothing clips or blurs. -->
  <LayoutTransformControl LayoutTransform="{DynamicResource Md3UiScaleTransform}">
    <shell:MainView />
  </LayoutTransformControl>
</Window>
