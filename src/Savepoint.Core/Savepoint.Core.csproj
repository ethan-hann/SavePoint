<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Savepoint.Core</RootNamespace>
    <!-- Every public Core API states its contract (D24): a missing XML doc comment fails the build here. -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsmResolver.PE.Win32Resources" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\Templates\*.json" LogicalName="Savepoint.Core.Catalog.Templates.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Savepoint.Core.Tests" />
    <InternalsVisibleTo Include="Savepoint.App.Tests" />
  </ItemGroup>

</Project>
